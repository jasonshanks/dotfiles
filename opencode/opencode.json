{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": "allow"
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": {
    "php": {
      "command": ["intelephense", "--stdio"],
      "extensions": [".php"],
      "initialization": {
        "intelephense": {
          "stubs": [
            "wordpress",
            "wp-cli",
            "woocommerce",
            "acf-pro",
            "/Users/jason/.composer/vendor/paulthewalton/acf-stubs"
          ],
          "files": {
            "maxSize": 5000000
          },
          "environment": {
            "phpVersion": "8.2"
          },
          "diagnostics": {
            "enable": true
          },
          "completion": {
            "fullyQualifyGlobalConstantsAndFunctions": true,
            "insertUseDeclaration": true
          },
          "format": {
            "enable": false
          }
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "figma-desktop": {
      "enabled": true,
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp",
      "timeout": 30000
    }
  },
  "plugin": ["oh-my-opencode-slim"]
}
