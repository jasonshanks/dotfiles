{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
  "compactSidebar": true,
  "preset": "opencode-free",
  "disabled_agents": [],
  "image_routing": "auto",
  "autoUpdate": true,
  "setDefaultAgent": true,
  "multiplexer": {
    "type": "auto",
    "layout": "main-vertical",
    "main_pane_size": 60
  },
  "scoringEngineVersion": "v2",
  "companion": {
    "enabled": false,
    "position": "bottom-left",
    "size": "small",
    "loopStyle": "smooth"
  },
  "presets": {
    "balanced-free": {
      "orchestrator": {
        "model": [
          "opencode/muse-spark-1.3-contributor-free",
          "omniroute/orchestrator"
        ],
        "temperature": 0.4,
        "skills": ["*", "!make-interfaces-feel-better"],
        "mcps": ["*", "!context7", "!gh_app"]
      },
      "oracle": {
        "model": [
          "opencode/muse-spark-1.3-contributor-free",
          "omniroute/oracle"
        ],
        "temperature": 0.4,
        "variant": "high",
        "skills": [
          "simplify",
          "ce-brainstorm",
          "workers-best-practices",
          "web-perf"
        ],
        "mcps": ["codegraph", "searxng", "crawl4ai"]
      },
      "explorer": {
        "model": ["opencode/nemotron-3.5-lightning-free", "omniroute/explorer"],
        "temperature": 0.2,
        "skills": [],
        "mcps": ["systemone", "*"]
      },
      "librarian": {
        "model": ["opencode/mimo-v2.6-flash-free", "omniroute/librarian"],
        "temperature": 0.2,
        "skills": [],
        "mcps": []
      },
      "designer": {
        "model": ["opencode/mimo-v2.6-flash-free", "omniroute/designer"],
        "temperature": 0.3,
        "variant": "xhigh",
        "skills": [
          "agent-browser",
          "frontend-design",
          "make-interfaces-feel-better",
          "better-icons",
          "vue",
          "nuxt",
          "motion",
          "image",
          "marketing-psychology",
          "video"
        ],
        "mcps": ["codegraph"]
      },
      "fixer": {
        "model": [
          "opencode/muse-spark-1.3-contributor-free",
          "omniroute/fixer"
