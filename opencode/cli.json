{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "keybinds": {
    "session.half.page.up": "<leader>k",
    "session.half.page.down": "<leader>j"
  },
  "plugins": [
    "oh-my-opencode-slim",
    "./herdr-opencode"
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true
}
