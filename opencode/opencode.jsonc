{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["oh-my-opencode-slim", "./plugins/rtk"],
  "instructions": ["instructions/*.md"],
  "permission": {
    "external_directory": "allow",
  },
  "agent": {
    "explore": {
      "disable": true,
    },
    "general": {
      "disable": true,
    },
  },
  "lsp": {
    "php": {
      "command": ["intelephense", "--stdio"],
      "extensions": [".php"],
      "initialization": {
        "intelephense": {
          "stubs": [
            "wordpress",
            "wp-cli",
            "woocommerce",
            "acf-pro",
            "/Users/jason/.composer/vendor/paulthewalton/acf-stubs",
          ],
          "files": {
            "maxSize": 5000000,
          },
          "environment": {
            "phpVersion": "8.2",
          },
          "diagnostics": {
            "enable": true,
          },
          "completion": {
            "fullyQualifyGlobalConstantsAndFunctions": true,
            "insertUseDeclaration": true,
          },
          "format": {
            "enable": false,
          },
        },
      },
    },
  },
  "provider": {
    "opencode": {
      "models": {
        "deepseek-v4.1-flash-free": {
          "limit": {
            "context": 1000000,
            "output": 384000,
          },
        },
      },
    },
    "omniroute": {
      "name": "OmniRoute",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "{env:OMNIROUTE_API_KEY}",
      },
      "models": {
        "auto/best-coding": {
          "name": "Auto Best Coding",
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 1050000,
            "output": 1048576,
            "input": 1050000,
          },
        },
        "auto/best-reasoning": {
