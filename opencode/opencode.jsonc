  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}",
      },
    },
    "figma-desktop": {
      "enabled": true,
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp",
      "timeout": 30000,
    },
    "local-first-systemone-mcp": {
      "enabled": true,
      "type": "local",
      "command": [
        "node",
        "/Users/jason/.dotfiles/opencode/mcp/local-first-systemone/server.js",
      ],
      "environment": {
        "OLLAMA_HOST": "http://localhost:11434",
        "SYSTEMONE_MODEL": "nimble:latest",
        "SYSTEMONE_FALLBACK_URL": "https://opencode.ai/inference/systemone/v1/systemone",
        "SYSTEMONE_FALLBACK_MODELS": "jev-1.13-free,jev-1.13",
        "OPENCODE_API_KEY": "{env:OPENCODE_API_KEY}",
        "SYSTEMONE_TIMEOUT": "30000",
      },
    },
  },
